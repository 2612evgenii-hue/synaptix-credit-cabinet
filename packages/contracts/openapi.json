  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        }
      },
      "ApplicationInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "amountMinor",
          "termMonths",
          "purpose"
        ],
        "properties": {
          "productId": {
            "type": "string"
          },
          "amountMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "termMonths": {
            "type": "integer",
            "minimum": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "Application": {
        "type": "object",
        "required": [
          "id",
          "state",
          "version",
          "amountMinor",
          "currency"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "DRAFT",
              "SUBMITTED",
              "VALIDATING",
              "NEEDS_INFO",
              "SCORING",
              "UNDER_REVIEW",
              "APPROVED",
              "REJECTED",
              "ACCEPTED",
              "SIGNED_SIMULATED",
              "DISBURSED_SIMULATED"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "amountMinor": {
            "type": "integer",
            "format": "int64"
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB"
            ]
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "id",
          "action",
          "occurredAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DecisionInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "outcome",
          "reasonCodes"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "outcome": {
            "type": "string",
            "enum": [
              "APPROVED",
              "REJECTED",
              "NEEDS_INFO"
            ]
          },
          "reasonCodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
