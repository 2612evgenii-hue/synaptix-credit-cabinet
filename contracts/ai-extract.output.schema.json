{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synaptix.local/contracts/ai-extract.output.schema.json",
  "title": "AIExtractOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal_code",
    "goal_text",
    "amount_rub",
    "amount_minor",
    "term_months",
    "evidence",
    "missing_fields",
    "ambiguities",
    "clarifying_questions",
    "needs_user_confirm",
    "meta"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "goal_code": {
      "type": ["string", "null"],
      "enum": ["working_capital", "equipment", "other", null]
    },
    "goal_text": {
      "type": ["string", "null"],
      "description": "Original user phrasing / cue for the goal; distinct from goal_code."
    },
    "amount_rub": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+(\\.[0-9]{2})?$",
      "description": "Canonical string rubles with two decimals; must match amount_minor when both set."
    },
    "amount_minor": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Integer kopecks; adapter must verify amount_rub * 100 == amount_minor."
    },
    "term_months": { "type": ["integer", "null"], "minimum": 1, "maximum": 600 },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goal": { "type": ["string", "null"] },
        "amount": { "type": ["string", "null"] },
        "term": { "type": ["string", "null"] }
      }
    },
    "missing_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ambiguities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "clarifying_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "needs_user_confirm": { "const": true },
    "meta": {
      "type": "object",
      "required": ["backend", "model_id", "used_llm"],
      "properties": {
        "backend": { "type": "string" },
        "model_id": { "type": "string" },
        "used_llm": { "type": "boolean" },
        "fallback_reason": { "type": ["string", "null"] },
        "injection_detected": { "type": "boolean" }
      }
    }
  }
}
