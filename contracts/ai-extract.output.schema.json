{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synaptix.local/contracts/ai-extract.output.schema.json",
  "title": "AIExtractOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal_code",
    "amount_rub",
    "term_months",
    "evidence",
    "missing_fields",
    "ambiguities",
    "needs_user_confirm"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "goal_code": {
      "type": ["string", "null"],
      "enum": ["working_capital", "equipment", "other", null]
    },
    "amount_rub": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+(\\.[0-9]{2})?$"
    },
    "term_months": { "type": ["integer", "null"], "minimum": 1, "maximum": 600 },
    "evidence": {
      "type": "object",
      "properties": {
        "goal": { "type": ["string", "null"] },
        "amount": { "type": ["string", "null"] },
        "term": { "type": ["string", "null"] }
      }
    },
    "missing_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ambiguities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "needs_user_confirm": { "const": true },
    "meta": { "type": "object" }
  }
}
